# Copy to an untracked .env.production file and fill every required value
# using your deployment platform's secret manager before deploying.
# This template is intentionally incomplete and will not start the backend.

NODE_ENV=production
PORT=5000
API_PREFIX=/api
APP_NAME=NOPTRIX

# Replace with the real public HTTPS URLs before deployment.
APP_URL=
BACKEND_URL=

# Supply a production MongoDB replica-set URI and a private Redis endpoint.
MONGODB_URI=
MONGODB_DB_NAME=noptrix
REDIS_URL=

# Generate two independent random secrets (at least 32 characters each).
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d

# Comma-separated exact HTTPS frontend origins.
CORS_ORIGIN=
COOKIE_DOMAIN=
COOKIE_SECURE=true

# Non-secret application settings carried over from the local .env.
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_FILE_SIZE_MB=10
LOG_LEVEL=info

# Keep online payments disabled until a provider is selected and configured.
PAYMENT_CURRENCY=BDT
PAYMENT_PROVIDER=
PAYMENT_ENABLE_COD=true
PAYMENT_ENABLE_ONLINE=false
