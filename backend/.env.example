# =========================================================
# NOPTRIX BACKEND ENVIRONMENT CONFIGURATION
# =========================================================
#
# IMPORTANT:
# 1. Copy this file to .env
# 2. Never commit .env to Git
# 3. Never expose secrets to frontend
# 4. Keep production secrets in a secure secret manager
#
# =========================================================


# =========================================================
# APPLICATION
# =========================================================

NODE_ENV=development

PORT=5000

API_PREFIX=/api

APP_NAME=NOPTRIX

APP_URL=http://localhost:3000

BACKEND_URL=http://localhost:5000


# =========================================================
# DATABASE — MONGODB
# =========================================================

# Example:
# mongodb://127.0.0.1:27017
# mongodb+srv://username:password@cluster.mongodb.net/

MONGODB_URI=

MONGODB_DB_NAME=noptrix


# =========================================================
# REDIS
# =========================================================

# Local Redis
REDIS_URL=redis://127.0.0.1:6379

# Example with password:
# redis://:password@127.0.0.1:6379

# Example Redis Cloud:
# redis://username:password@host:port


# =========================================================
# AUTHENTICATION — JWT
# =========================================================

# Minimum 32 characters.
# Use a cryptographically random secret in production.

JWT_SECRET=

JWT_EXPIRES_IN=7d


# =========================================================
# AUTHENTICATION — REFRESH TOKEN
# =========================================================

# Minimum 32 characters.
# MUST be different from JWT_SECRET.

REFRESH_TOKEN_SECRET=

REFRESH_TOKEN_EXPIRES_IN=30d


# =========================================================
# CORS
# =========================================================

# Development:
CORS_ORIGIN=http://localhost:3000

# Production example:
# CORS_ORIGIN=https://your-domain.com


# =========================================================
# COOKIE
# =========================================================

# Leave empty for localhost development.
COOKIE_DOMAIN=

# false for local HTTP
# true for production HTTPS

COOKIE_SECURE=false


# =========================================================
# CLOUDINARY
# =========================================================

# Leave empty if Cloudinary is not being used yet.

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=


# =========================================================
# SMTP / EMAIL
# =========================================================

# Example providers:
# Gmail SMTP
# Brevo
# SendGrid
# Mailgun
# Amazon SES

SMTP_HOST=

SMTP_PORT=587

SMTP_USER=

SMTP_PASSWORD=

SMTP_FROM=


# =========================================================
# SMS
# =========================================================

# Supported architecture:
# twilio
# vonage
# messagebird
# custom

# Leave empty to disable SMS.

SMS_PROVIDER=

SMS_API_KEY=

SMS_API_SECRET=

SMS_FROM=


# =========================================================
# FIREBASE ADMIN
# =========================================================

# Used for server-side Firebase services
# such as push notifications.

FIREBASE_PROJECT_ID=

FIREBASE_CLIENT_EMAIL=

# Keep \n characters when copying the private key
# into the environment variable.

FIREBASE_PRIVATE_KEY=


# =========================================================
# SECURITY
# =========================================================

# bcrypt password hashing rounds.
# Recommended range in env.ts: 10-15.

BCRYPT_SALT_ROUNDS=12


# =========================================================
# RATE LIMITING
# =========================================================

# 15 minutes = 900000 milliseconds

RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window.

RATE_LIMIT_MAX=100


# =========================================================
# LOGGING
# =========================================================

# Supported:
# fatal
# error
# warn
# info
# debug
# trace

LOG_LEVEL=info


# =========================================================
# OTP
# =========================================================

# OTP digit length

OTP_LENGTH=6

# OTP lifetime in minutes

OTP_EXPIRES_IN_MINUTES=5

# Maximum verification attempts

OTP_MAX_ATTEMPTS=5

# Minimum delay before requesting another OTP

OTP_RESEND_COOLDOWN_SECONDS=60


# =========================================================
# FILE UPLOAD
# =========================================================

# Maximum uploaded file size in MB

MAX_FILE_SIZE_MB=10


# =========================================================
# PAYMENT
# =========================================================

# ISO 4217 three-letter currency code.
# Bangladesh:
PAYMENT_CURRENCY=BDT


# ---------------------------------------------------------
# PAYMENT PROVIDER
# ---------------------------------------------------------
#
# Supported architecture:
#
# sslcommerz
# stripe
# paypal
# razorpay
# custom
#
# Leave empty when online payment is disabled.

PAYMENT_PROVIDER=


# ---------------------------------------------------------
# PAYMENT WEBHOOK SECURITY
# ---------------------------------------------------------
#
# Minimum 16 characters.
# Use a strong random secret in production.

PAYMENT_WEBHOOK_SECRET=


# ---------------------------------------------------------
# PAYMENT CALLBACK URLS
# ---------------------------------------------------------

# Frontend success page

PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success

# Frontend cancellation page

PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# Frontend failure page

PAYMENT_FAIL_URL=http://localhost:3000/payment/fail


# ---------------------------------------------------------
# PAYMENT WEBHOOK / IPN
# ---------------------------------------------------------

# Backend endpoint that receives
# payment provider callbacks.

PAYMENT_IPN_URL=http://localhost:5000/api/payment/webhook


# ---------------------------------------------------------
# PAYMENT HTTP REQUEST
# ---------------------------------------------------------

# Maximum time allowed for an external
# payment provider request.

PAYMENT_REQUEST_TIMEOUT_MS=15000


# Maximum retry attempts for retry-safe
# external payment operations.

PAYMENT_MAX_RETRIES=2


# ---------------------------------------------------------
# PAYMENT IDEMPOTENCY
# ---------------------------------------------------------

# How long payment idempotency keys remain
# protected from duplicate operations.
#
# 86400 seconds = 24 hours

PAYMENT_IDEMPOTENCY_TTL_SECONDS=86400


# ---------------------------------------------------------
# PAYMENT WEBHOOK TIMESTAMP SECURITY
# ---------------------------------------------------------

# Maximum allowed timestamp difference
# between webhook request and server time.
#
# 300 seconds = 5 minutes

PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300


# ---------------------------------------------------------
# PAYMENT METHODS
# ---------------------------------------------------------

# Cash On Delivery

PAYMENT_ENABLE_COD=true

# Online payment gateway

# Keep false until a real payment provider
# has been configured and tested.

PAYMENT_ENABLE_ONLINE=false


# =========================================================
# END OF NOPTRIX ENVIRONMENT CONFIGURATION
# =========================================================